<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net461      => UiPath "Windows - Legacy" projects
         net6.0      => UiPath "Windows" projects (Studio 2021.10+, also loads in .NET 8 projects) -->
    <TargetFrameworks>net461;net6.0</TargetFrameworks>
    <RootNamespace>Shaker.SQLLiteDB.Activities</RootNamespace>
    <AssemblyName>Shaker.SQLLiteDB.Activities</AssemblyName>
    <AssemblyTitle>Shaker SQLite Activities</AssemblyTitle>

    <PackageId>Shaker.SQLLiteDB.Activities</PackageId>
    <Title>Shaker SQLite Activities</Title>
    <Description>UiPath activity library for SQLite databases. Uses the embedded SQLitePCLRaw (e_sqlite3) native engine, so no ODBC driver, no System.Data.SQLite installation and no machine level configuration are required. Supports concurrent readers (WAL), serialized writers guarded by a cross process lock file, transactions, bulk insert/upsert, batch execution and export to CSV, XLSX and JSON.</Description>
    <PackageTags>UiPath;Activities;RPA;SQLite;Database;WAL;CSV;Excel;XLSX;Workflow</PackageTags>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(ArtifactsDirectory)</PackageOutputPath>

    <!-- UiPath Studio reads these to place the package in the activity panel. -->
    <NoWarn>$(NoWarn);NU5100;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project checks the locking internals. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Shaker.SQLLiteDB.Activities.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded SQLite engine: the native e_sqlite3 library ships inside the package,
         nothing has to be installed or registered on the robot machine. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Activities" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <!-- System.Activities for modern .NET, as shipped and used by UiPath Studio. -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
  </ItemGroup>

</Project>
