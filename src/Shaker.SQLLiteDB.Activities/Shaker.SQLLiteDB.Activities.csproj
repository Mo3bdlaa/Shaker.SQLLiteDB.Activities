<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same pair UiPath's own activity packages ship:
         net6.0-windows => UiPath "Windows" projects (packs as lib/net6.0-windows7.0)
         net6.0         => UiPath "Cross-platform" projects
         Windows - Legacy (net461) is deliberately not built: Studio refused the package for Windows
         projects while a .NET Framework assembly was in it, and UiPath dropped that target from their
         own packages too. -->
    <TargetFrameworks>net6.0;net6.0-windows</TargetFrameworks>
    <RootNamespace>Shaker.SQLLiteDB.Activities</RootNamespace>
    <AssemblyName>Shaker.SQLLiteDB.Activities</AssemblyName>
    <AssemblyTitle>Shaker SQLite Activities</AssemblyTitle>

    <PackageId>Shaker.SQLLiteDB.Activities</PackageId>
    <Title>Shaker SQLite Activities</Title>
    <Description>UiPath activity library for SQLite databases. Uses an embedded SQLitePCLRaw (SQLCipher) native engine, so no ODBC driver, no System.Data.SQLite installation and no machine level configuration are required, and AES-256 encrypted databases work out of the box. Supports concurrent readers (WAL), serialized writers guarded by a cross process lock file, transactions, bulk insert/upsert, batch execution and export to CSV, XLSX and JSON.</Description>
    <PackageTags>UiPath;Activities;RPA;SQLite;SQLCipher;Encryption;Database;WAL;CSV;Excel;XLSX;Workflow</PackageTags>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Ships the same target frameworks as UiPath own activity packages (net6.0-windows7.0 and net6.0) so Studio accepts the package for Windows projects. Windows - Legacy is no longer supported.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(ArtifactsDirectory)</PackageOutputPath>

    <!-- UiPath Studio reads these to place the package in the activity panel. -->
    <NoWarn>$(NoWarn);NU5100;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project checks the locking internals. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Shaker.SQLLiteDB.Activities.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded SQLite engine: the native SQLCipher build of SQLite ships inside the package, so
         nothing has to be installed or registered on the robot machine and encrypted databases work
         out of the box. It is a superset of plain SQLite: databases without a password behave exactly
         as before. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Activities for modern .NET. Compile time only, exactly like System.Activities is on
         .NET Framework: the workflow host - UiPath Studio and the robot - brings its own copy at run
         time, and shipping a second one as a package dependency gives the project two System.Activities
         assemblies, which is enough for Studio to stop recognising the activities. -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
