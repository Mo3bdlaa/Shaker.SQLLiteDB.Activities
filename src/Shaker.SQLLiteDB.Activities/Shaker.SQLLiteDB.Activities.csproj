<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net461 => UiPath "Windows - Legacy" projects
         net6.0 => UiPath "Windows" projects
         Studio matches a Windows project against the plain net6.0 folder. The windows flavoured
         net6.0-windows7.0 is what newer UiPath packages ship, but Studio 2022.10 rejects a package
         that offers it, so this library stays on the pair that Studio accepts. -->
    <TargetFrameworks>net461;net6.0</TargetFrameworks>
    <RootNamespace>Shaker.SQLLiteDB.Activities</RootNamespace>
    <AssemblyName>Shaker.SQLLiteDB.Activities</AssemblyName>
    <AssemblyTitle>Shaker SQLite Activities</AssemblyTitle>

    <PackageId>Shaker.SQLLiteDB.Activities</PackageId>
    <Title>Shaker SQLite Activities</Title>
    <Description>UiPath activity library for SQLite databases. Uses an embedded SQLitePCLRaw (SQLCipher) native engine, so no ODBC driver, no System.Data.SQLite installation and no machine level configuration are required, and AES-256 encrypted databases work out of the box. Supports concurrent readers (WAL), serialized writers guarded by a cross process lock file, transactions, bulk insert/upsert, batch execution and export to CSV, XLSX and JSON.</Description>
    <PackageTags>UiPath;Activities;RPA;SQLite;SQLCipher;Encryption;Database;WAL;CSV;Excel;XLSX;Workflow</PackageTags>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/Shaker.SQLLiteDB.Activities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>The eight day to day activities now sit directly under SQLite, with Export, Schema, Maintenance and Advanced one level deeper. Every activity result argument has a real name, an Output category and a tooltip instead of sitting unlabelled in Misc. Bulk Insert is now Insert Data Table and Execute Batch is now Execute Statements.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(ArtifactsDirectory)</PackageOutputPath>

    <!-- UiPath Studio reads these to place the package in the activity panel. -->
    <!-- NU5104: System.Activities.ViewModels only ever ships with a prerelease version string. -->
    <NoWarn>$(NoWarn);NU5100;NU5104;NU5128;CS1591</NoWarn>

    <!-- The package carries its dependencies inside lib/ instead of declaring them: nothing for Studio
         to resolve when it installs. The references below are marked PrivateAssets="all" to achieve
         that, rather than SuppressDependenciesWhenPacking, because that property removes the whole
         <dependencies> element from the manifest - and Studio reads the target framework groups in
         there to decide which project types the package supports. With no element it concludes the
         package supports nothing and reports it as not compatible with Windows projects. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleDependencyAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project checks the locking internals. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Shaker.SQLLiteDB.Activities.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\package-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded SQLite engine: the native SQLCipher build of SQLite ships inside the package, so
         nothing has to be installed or registered on the robot machine and encrypted databases work
         out of the box. It is a superset of plain SQLite: databases without a password behave exactly
         as before. -->
    <PackageReference PrivateAssets="all" Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference PrivateAssets="all" Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference PrivateAssets="all" Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference PrivateAssets="all" Include="SQLitePCLRaw.lib.e_sqlcipher" Version="2.1.10" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Activities" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <!-- System.Activities for modern .NET. Compile time only: the workflow host - Studio and the
         robot - brings its own copy at run time.
         The version matters. Studio ships System.Activities 6.0.0.0, and an assembly compiled against
         a higher one (nuget.org's UiPath.Workflow.Runtime 6.0.3 produces a 6.0.3.0 reference) cannot
         be loaded by it, which Studio reports as "not compatible with Windows projects". This package
         from UiPath's own feed is the 6.0.0.0 build. -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.0-20220401-03" PrivateAssets="all" ExcludeAssets="runtime" />

    <!-- The designer view models: the fields drawn inside the activity body, instead of only in the
         Properties panel. This one IS declared as a package dependency, unlike everything else here.
         It has to be: the workflow runtime reads every attribute on an activity through
         TypeDescriptor before running it, so the attribute type must resolve on the robot too, not
         only in Studio. UiPath's own Database activities declare the same dependency for the same
         reason. Studio and the robot restore it from the UiPath Official feed, which is enabled out
         of the box. The version is the oldest one built for net6.0, so it covers the widest range of
         Studio releases; its assembly version is 1.0.0.0, as it is in every other published version,
         so a newer Studio happily binds our assembly to its own newer copy. -->
    <PackageReference Include="System.Activities.ViewModels" Version="1.0.0-20231101.6" />
  </ItemGroup>

  <!-- Everything the library needs at run time, packed beside our own assembly. Native files are
       excluded here and added explicitly below: this build runs on Linux, so the native picked up
       automatically would be the Linux one. -->
  <Target Name="BundleDependencyAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- Only the SQLite stack. The .NET Framework build would otherwise drag in the whole set of
           netstandard facade assemblies, which have no business inside an activity package. -->
      <BundledDependency Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And (
                                    '%(ReferenceCopyLocalPaths.Filename)' == 'Microsoft.Data.Sqlite' Or
                                    '%(ReferenceCopyLocalPaths.Filename)' == 'SQLitePCLRaw.core' Or
                                    '%(ReferenceCopyLocalPaths.Filename)' == 'SQLitePCLRaw.batteries_v2' Or
                                    '%(ReferenceCopyLocalPaths.Filename)' == 'SQLitePCLRaw.provider.e_sqlcipher' Or
                                    '%(ReferenceCopyLocalPaths.Filename)' == 'SQLitePCLRaw.provider.dynamic_cdecl')" />
      <BuildOutputInPackage Include="@(BundledDependency)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ESqlCipherNative>$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlcipher/2.1.10/runtimes</ESqlCipherNative>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native SQLCipher engine for Windows, in every layout a host might look in.
         runtimes/win-<arch>/native is the one NuGet itself understands and the only place a normal
         restore will copy from - a plain .dll inside lib/ is not a managed assembly, so NuGet skips
         it, which is why a robot could install this package and still fail to load the engine.
         The lib/ copies remain for the .NET Framework loader and for hosts that just extract the
         package; SQLiteNative.PreloadWindowsEngine walks all of these by full path at startup. -->
    <None Include="$(ESqlCipherNative)/win-x64/native/e_sqlcipher.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/;lib/net461/;lib/net461/x64/;lib/net6.0/;lib/net6.0/x64/" Visible="false" />
    <None Include="$(ESqlCipherNative)/win-x86/native/e_sqlcipher.dll"
          Pack="true" PackagePath="runtimes/win-x86/native/;lib/net461/x86/;lib/net6.0/x86/" Visible="false" />
  </ItemGroup>

</Project>
