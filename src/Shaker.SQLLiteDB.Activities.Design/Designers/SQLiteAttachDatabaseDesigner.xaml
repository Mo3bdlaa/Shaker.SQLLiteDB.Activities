<sap:ActivityDesigner x:Class="Shaker.SQLLiteDB.Activities.Design.Designers.SQLiteAttachDatabaseDesigner"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
                      xmlns:sapv="clr-namespace:System.Activities.Presentation.View;assembly=System.Activities.Presentation"
                      xmlns:sapc="clr-namespace:System.Activities.Presentation.Converters;assembly=System.Activities.Presentation">
    <sap:ActivityDesigner.Icon>
      <DrawingBrush Stretch="Uniform">
        <DrawingBrush.Drawing>
          <DrawingGroup>
              <GeometryDrawing Brush="#475569" Geometry="M 3,0 L 13,0 A 3,3 0 0 1 16,3 L 16,13 A 3,3 0 0 1 13,16 L 3,16 A 3,3 0 0 1 0,13 L 0,3 A 3,3 0 0 1 3,0 Z" />
              <GeometryDrawing Brush="#FFFFFF" Geometry="M 2.4,3.4 L 9.2,3.4 L 9.2,10.2 L 2.4,10.2 Z" />
              <GeometryDrawing Geometry="M 6.8,5.8 L 13.6,5.8 L 13.6,12.6 L 6.8,12.6 Z"><GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </sap:ActivityDesigner.Icon>
  <sap:ActivityDesigner.Resources>
    <sapc:ArgumentToExpressionConverter x:Key="ArgumentToExpressionConverter" />
  </sap:ActivityDesigner.Resources>
  <Grid Margin="4">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="190" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connection" Margin="0,5,8,5" VerticalAlignment="Center" />
    <sapv:ExpressionTextBox x:Name="ConnectionBox" Grid.Row="0" Grid.Column="1" Margin="0,2"
                            HintText="Connection"
                            OwnerActivity="{Binding Path=ModelItem}"
                            Expression="{Binding Path=ModelItem.Connection, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}" />
    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database to attach" Margin="0,5,8,5" VerticalAlignment="Center" />
    <sapv:ExpressionTextBox x:Name="AttachPathBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                            HintText="Path of the database file to attach"
                            OwnerActivity="{Binding Path=ModelItem}"
                            Expression="{Binding Path=ModelItem.AttachPath, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}" />
    <TextBlock Grid.Row="2" Grid.Column="0" Text="Alias" Margin="0,5,8,5" VerticalAlignment="Center" />
    <sapv:ExpressionTextBox x:Name="AliasBox" Grid.Row="2" Grid.Column="1" Margin="0,2"
                            HintText="Name the attached database gets in SQL, for example 'archive'"
                            OwnerActivity="{Binding Path=ModelItem}"
                            Expression="{Binding Path=ModelItem.Alias, Mode=TwoWay, Converter={StaticResource ArgumentToExpressionConverter}, ConverterParameter=In}" />
  </Grid>
</sap:ActivityDesigner>
